# =====================================
# 数据库配置
# =====================================

# PostgreSQL 配置
POSTGRES_USER=zenit
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=zenit_db
POSTGRES_PORT=5432

# 数据库连接字符串（供后端或 Next.js API Routes 使用）
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# =====================================
# 前端配置
# =====================================

# 前端服务端口
FRONTEND_PORT=3000

# 后端 API 端口（自部署版：backend 服务）
BACKEND_PORT=3001

# 前端访问后端的 API 地址（浏览器端调用，需要用公网地址/域名）
# 本地自部署示例：http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# =====================================
# AI 功能配置 (可选)
# =====================================

# OpenAI 兼容 API 配置 (支持 OpenAI / Azure / 国产大模型)
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 本地模型配置 (如果使用 Ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# 是否启用 AI 功能
ENABLE_AI=false

# =====================================
# 后端配置（如果你有后端服务）
# =====================================

# 后端服务端口
# BACKEND_PORT=3001

# JWT 密钥（用于登录认证）
# JWT_SECRET=your_jwt_secret_key_here

# =====================================
# 其他配置
# =====================================

# 时区设置
TZ=Asia/Shanghai
