# Zenit Backend (self-host) env example

# Backend port
PORT=3001

# Database connection
# Local dev (Postgres running on your machine):
DATABASE_URL=postgresql://zenit:your_secure_password_here@localhost:5432/zenit_db?schema=public

# If running backend inside docker-compose, use:
# DATABASE_URL=postgresql://zenit:your_secure_password_here@postgres:5432/zenit_db?schema=public
